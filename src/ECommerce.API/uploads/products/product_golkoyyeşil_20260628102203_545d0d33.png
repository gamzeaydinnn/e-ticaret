blished":null},{"path":"tools/customize-background","name":null,"lang":"ko","published":null},{"path":"tools/customize-background","name":null,"lang":"ms","published":null},{"path":"tools/customize-background","name":null,"lang":"pt-br","published":null},{"path":"tools/customize-background","name":null,"lang":"pt-pt","published":null},{"path":"tools/customize-background","name":null,"lang":"ru","published":null},{"path":"tools/customize-background","name":null,"lang":"th","published":null},{"path":"tools/customize-background","name":null,"lang":"tr","published":null},{"path":"tools/customize-background","name":null,"lang":"vi","published":null}]},"component":"EditorialCardBlock","direction":"vertical"}],"title":[{"_uid":"e0db1ac3-c775-416f-ad08-2c7151589811","title":"Ücretsiz araçlarımızı keşfedin","subtitle":"Tamamen ücretsiz özelliklerle fotoğraflarınızı öne çıkarın.","component":"SectionTitle"}],"component":"EditorialLineupBlock"},{"_uid":"6f13bcbb-1df4-4251-82cd-0591ee0a014b","items":[{"_uid":"bc5b1fa5-044b-4d88-ac30-c5d6dfdf6034","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Photoroom özellikle e-ticaret ve marka görselleri için tasarlandı. Yapay zeka destekli arka plan kaldırıcı, arka planı anında siler ve istersen şeffaf arka planı bir studio veya yaşam tarzı ortamıyla değiştirebilirsin.","type":"text"}]}]},"question":"Ürün fotoğrafları için en iyi arka plan kaldırıcı hangisi?","component":"FaqItem"},{"_uid":"316f4e56-3b74-4014-b872-749a48f0bc54","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Bir görsel yüklediğinde, Photoroom’un yapay zeka destekli arka plan kaldırıcı aracı, görselindeki ana nesneyi (ürün, kişi veya obje) algılar ve izole eder, ardından arka plandan ayırıp siler.","type":"text"}]}]},"question":"Fotoğraftan arka plan nasıl kaldırılır?","component":"FaqItem"},{"_uid":"f0441a85-806a-4c4e-b161-743cfcc1636b","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Photoroom ile herhangi bir görselin Arka planını kaldırırken tüm detayları koruyabilirsin. Yapay zeka destekli Arka plan kaldırıcı, görselin çözünürlüğünü, keskinliğini ve kenar hassasiyetini korur; böylece ürünün veya konun net ve doğal kalır.","type":"text"}]}]},"question":"Bir görselin arka planını kalite kaybı olmadan kaldırabilir miyim?","component":"FaqItem"},{"_uid":"9c62227d-a477-4e27-b252-0459752c2eba","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Photoroom mobilde ve masaüstünde kullanılabilir.","type":"text"},{"text":"Mobilde ve masaüstünde","type":"text","marks":[{"type":"link","attrs":{"href":"/across-devices","title":null,"story":{"name":"across-devices"}}}]},{"text":" hemen ücretsiz başlayıp arka planları kaldırabilirsin. Hazır olduğunda, ","type":"text"},{"text":"daha fazla","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/pricing","title":null,"story":{"name":"Pro, Max, Ultra ve Enterprise Planlarını Karşılaştırın"}}}]},{"text":" YZ fotoğraf düzenleme aracına ve yüksek çözünürlüklü dışa aktarmalara erişmek için yükseltebilirsin.","type":"text"}]}]},"question":"Arka plan kaldırma aracı ücretsiz mi?","component":"FaqItem"},{"_uid":"47a7448b-5e7a-4520-b232-08011d04f3f9","answer":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Fotoğrafını Photoroom'a yükle, yapay zeka destekli arka plan kaldırıcı arka planı otomatik olarak silsin. Arka planı şeffaf bırakabilir ya da profesyonel bir studio ortamı, ","type":"text"},{"text":"lifestyle","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/ai-product-photography/lifestyle","title":null,"story":{"name":"Gerçekçi yaşam tarzı ürün fotoğraflarını yapay zeka ile oluştur"}}}]},{"text":" sahnesi veya ","type":"text"},{"text":"YZ Arka Planlar","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/tools/instant-backgrounds","title":null,"story":{"name":"YZ Arka Planlar"}}}]},{"text":" ","type":"text"},{"text":"ile özel bir arka planla değiştir.","type":"text","ma