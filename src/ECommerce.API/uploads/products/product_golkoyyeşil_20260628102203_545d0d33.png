:"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/191576/x/4f9dc3ca36/remove-background-animation-v1_1.mp4","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"FeatureBlockClassicVisualVideo","hasOriginalAspectRatio":false}],"descriptionText":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Maliyetli ve zaman alan fotoğraf düzenleme süreçlerini ortadan kaldır, kaynaklarını işini büyütmeye odakla. İster bağımsız bir satıcı ister küresel bir marka ol, ","type":"text"},{"text":"online mağaza","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/use-cases/sell-online","title":null,"story":{"name":"İlgiyi satışa dönüştürün"}}}]},{"text":" veya ","type":"text"},{"text":"Pazar Yeri","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/industry/marketplaces","title":null,"story":{"name":"E-ticaret"}}}]},{"text":" için saniyeler içinde yapay zeka ile arka planı kaldır, satışa hazır ürün fotoğrafları oluştur.","type":"text"}]}]},"withVisualBorder":false,"visualAspectRatio":""},{"_uid":"abbae669-f9e2-4090-88ce-f56e9280c307","type":"","wide":true,"title":"Daha fazla ücretsiz düzenleme seçeneği","ctaLink":{"id":"","url":"https://app.photoroom.com/signup","linktype":"url","fieldtype":"multilink","cached_url":"https://app.photoroom.com/signup","href":"https://app.photoroom.com/signup","target":"_blank","rel":"noopener noreferrer"},"ctaLabel":"Ücretsiz başla","component":"FeatureBlock","invertOrder":true,"visualElement":[{"_uid":"ae948222-49aa-42ae-9657-91a5cf0ea727","image":{"id":111710342688384,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/191576/1176x882/10e2a84993/remove_backgroud_2.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false,"blurDataURL":"data:image/webp;base64,UklGRl4AAABXRUJQVlA4IFIAAADwAQCdASoQAAwABUB8JYwAAvqAvEwfQwAA/utyBj5FsrDM4dFK3qBBTCcp+0plmD75RisV/wa0LzxbBEWEY+qBRdKtSaVMpqmWjy6YooAZ8AAA"},"component":"FeatureBlockClassicVisualImage"}],"descriptionText":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Yüzlerce ürün görselinden Arka planı manuel olarak silmek, lansman sürecini yavaşlatır ve ekibini zorlar. İş akışını hızlandır ve büyük hacimli fotoğraf düzenlemelerini dakikalar içinde, herhangi bir cihazdan yap. Yeni e-ticaret ürünleri için hazırlan ve ","type":"text"},{"text":"Amazon listelemelerini","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/ai-product-photography/amazon","title":null,"story":{"name":"Amazon ürün fotoğraflarını YZ ile oluştur"}}}]},{"text":" ","type":"text"},{"text":"Toplu","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/tools/batch-mode","title":null,"story":{"name":"Toplu İşlem Modu"}}}]},{"text":" veya ","type":"text"},{"text":"API","type":"text","marks":[{"type":"link","attrs":{"href":"/api/marketplace-playground","title":null,"story":{"name":"Marketplace API Playground"}}}]},{"text":" ile tüm kataloglarda Arka planı kaldırırken tutarlı ve yüksek kaliteli görseller elde et.","type":"text"}]}]},"withVisualBorder":false,"visualAspectRatio":""},{"_uid":"f7b07a4e-753d-46a7-b9f4-92c8d4e62f68","type":"","wide":true,"title":"Mükemmelliğin Arka Planı","ctaLink":{"id":"","url":"https://app.photoroom.com/signup","linktype":"url","fieldtype":"multilink","cached_url":"https://app.photoroom.com/signup","href":"https://app.photoroom.com/signup","target":"_blank","rel":"noopener noreferrer"},"ctaLabel":"Ücretsiz başla","component":"FeatureBlock","listItems":[],"invertOrder":false,"visualElement":[{"_uid":"0d8a9f86-b0dc-4d03-9774-d44e136c9392","image":{"id":111710342626943,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/191576/1176x882/90531ab2aa/remove_background_3.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false,"blurDataURL":"data:image/webp;base64,UklGRkYAAABXRUJQVlA4IDoAAACwAQCdASoQAAwABUB8JaACdAEO9p5AAP7tcIB5ZvozEkzRJNt4LBp1/DYqp1EJHjebAJ5zEi8i1AAA"},"component":"FeatureBlockClassicVisualImage"}],"descriptionText":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Düşük kaliteli veya tutarsız ürün görselleri yüzünden müşteri mi kaybediyorsun? Markanın görsel kimliğini güçlendir, tüm satış kanallarında tıklanma ve dönüşüm oranlarını artırmak için yapay zeka destekli arka plan kaldırıcıyı kullan. Öne çık, müşteri güveni oluştur ve yüksek kaliteli ","type":"text"},{"text":"yapay zeka ürün fotoğrafçılığı","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/ai-product-photography","title":null,"story":{"name":"YZ ürün fotoğrafçılığı ile satışlarını artır"}}}]},{"text":" ile satışlarını artır.","type":"text"}]}]},"visualAspectRatio":""},{"_uid":"c77f79f8-0293-462a-949d-8974365bf80e","type":"","wide":true,"title":"İş akışınızda uyumu yakalayın","ctaLink":{"id":"","url":"https://app.photoroom.com/signup","linktype":"url","fieldtype":"multilink","cached_url":"https://app.photoroom.com/signup","href":"https://app.photoroom.com/signup","target":"_blank","rel":"noopener noreferrer"},"ctaLabel":"Ücretsiz başla","component":"FeatureBlock","invertOrder":true,"visualElement":[{"_uid":"ecc162f7-5b3b-409e-acdc-4063eb1d7d8b","image":{"id":110902696789953,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/191576/1176x882/b69a340cf2/remove-background-4.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false,"blurDataURL":"data:image/webp;base64,UklGRmYAAABXRUJQVlA4IFoAAAAwAgCdASoQAAwABUB8JQBdgMXrxrJpq5sbAAD+6yXoByG4muujcv+mNXAtNOEQijDB+/EJxKuxmosEULDAfCiA2PzJPBWyeYOKqcqLXsAOJuiZMO0SoeMAAAA="},"component":"FeatureBlockClassicVisualImage"}],"descriptionText":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Photoroom ile masaüstü ve mobil cihazlarda kolayca ","type":"text"},{"text":"toplu işlem","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/tools/batch-mode","title":null,"story":{"name":"Toplu İşlem Modu"}}}]},{"text":" yapabilir, ","type":"text"},{"text":"ekibinizle birlikte kesintisiz çalışabilirsiniz","type":"text","marks":[{"type":"link","attrs":{"href":"/tr/teams","title":null,"story":{"name":"Ekibinle iş birliği yap"}}}]},{"text":". Büyük miktarda görüntü sorunsuz bir şekilde işlenirken, ekip üyeleriniz de yorumlarını paylaşabilir ve verimli bir düzenleme süreci sağlayacak iş akışları oluşturabilir. Görüntünüzü hemen yükleyin ve Çevrimiçi Arka Plan Kaldırma aracımızla çarpıcı tasarımlara dönüştürün.","type":"text"}]}]},"visualAspectRatio":""}],"component":"FeaturesBlock"},{"_uid":"5e340ded-c4f8-454c-8f5d-772bdaacd34d","items":[{"_uid":"6a6ed0b3-f738-45d8-bda0-efa27a9083de","data":"%96","title":"satışlarda ortalama artış","subtitle":"","component":"SingleData"},{"_uid":"03fcc7b8-e1be-46d3-9274-3c04625bb7dc","data":"%93","title":"fotoğraf düzenleme maliyetlerinde azalma","subtitle":"","component":"SingleData"},{"_uid":"99755bdf-480a-4820-91c2-c0c83ef6ef30","data":"%56","title":"satış oranında artış","subtitle":"","component":"SingleData"},{"_uid":"823ec8dd-354b-4d03-a1b9-5b010a4a59f7","data":"%99","title":"görsel marka uyumluluğu sağlandı","subtitle":"","component":"SingleData"}],"title":[{"_uid":"585dcc36-e9b1-4a31-9fb7-4d3862896299","title":"Photoroom kullanan markalardan ve pazar yerlerinden gerçek sonuçlar","component":"SmallSectionTitle"}],"component":"DataBlock"},{"_uid":"4cc04f1c-5d97-41d2-9531-301330beb891","steps":[{"_uid":"f94ada5e-ed6f-462e-88fb-282cf9664ebb","title":"Bir görüntü seçin 📷","content":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"JPEG veya PNG formatında ürün görselini yükle; her boyut kabul edilir. Arka planı senin için kaldırıyoruz.","type":"text"}]}]},"component":"StepItem","badgeTitle":"Adım 1"},{"_uid":"7c2133ca-a246-4ae2-9692-8bce979f804d","title":"Arka plan sihirli bir değnekle kalksın ✨","content":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Photoroom arka planı kaldırır. İster şeffa